# SpicyOps: variables opcionales para desarrollo
# La aplicación Windows genera y protege su clave automáticamente.
# No se requiere PostgreSQL, seed ni migraciones.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# SPICYOPS_STATE_DIR=RUTA_PRIVADA_DE_DATOS
# DJANGO_SECRET_KEY=CONFIGURAR_SOLO_SI_ADMINISTRAS_UN_DESPLIEGUE_DE_DESARROLLO
# Este archivo no se carga automáticamente ni se incluye en el ejecutable.
