{
  "name": "spicyops-guia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content": "node scripts/content.mjs",
    "dev": "npm run content && vite --host 127.0.0.1",
    "build": "npm run content && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:python": "python scripts/check_python.py",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "marked": "18.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
